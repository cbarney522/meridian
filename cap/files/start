#!/bin/bash
# Meridian R700 App — entry point run by the Impinj R700 at boot.
# The CAP is mounted read-only at /cust; only /cust/rw_dir is writable (see input_manifest.json).
# This script runs in the foreground forever and supervises the Meridian server.
#
# Author: Clifford Barney

CAP_ROOT="$(cd "$(dirname "$0")" && pwd)"
[ -f "$CAP_ROOT/app.env" ] && . "$CAP_ROOT/app.env"
UI_PORT="${UI_PORT:-8443}"
RW="$CAP_ROOT/rw_dir"
LOG_DIR="$RW/log"
LOG="$LOG_DIR/meridian.log"
mkdir -p "$LOG_DIR"

export CAP_DATA_DIR="$RW"
export PYTHONDONTWRITEBYTECODE=1    # never write .pyc into the read-only partition
# Time-zone database: the reader's own if it has one, else the copy bundled in the CAP.
export PYTHONTZPATH="/usr/share/zoneinfo:$CAP_ROOT/zoneinfo"

# ---- startup diagnostics: what can this reader's CAP runtime actually do?
{
  echo "Meridian diagnostics  $(date -u '+%Y-%m-%dT%H:%M:%SZ')  version $(cat "$CAP_ROOT/app/VERSION" 2>/dev/null)"
  echo "kernel:   $(uname -a)"
  [ -f /etc/os-release ] && grep -E '^(NAME|VERSION)=' /etc/os-release
  echo "user:     $(id)"
  echo "cap_root: $CAP_ROOT"
  echo "glibc:    $(getconf GNU_LIBC_VERSION 2>/dev/null || ldd --version 2>&1 | head -1)"
  if [ -x "$CAP_ROOT/python/bin/python3" ]; then
    echo "python:   $("$CAP_ROOT/python/bin/python3" -c 'import sys,ssl; print(sys.version.split()[0], "|", ssl.OPENSSL_VERSION)' 2>&1)"
  else
    echo "python:   bundled python NOT PRESENT"
  fi
  for t in python3 openssl curl busybox bash lsusb mount umount mkfs.ext4 mke2fs mkfs.vfat blkid udisksctl sync; do
    p="$(command -v "$t" 2>/dev/null)"; echo "$t: ${p:-NOT FOUND}"
  done
  echo "rw_dir writable: $( (touch "$RW/.probe" && rm -f "$RW/.probe" && echo yes) 2>/dev/null || echo NO)"
  df -h "$CAP_ROOT" "$RW" 2>/dev/null
  echo
  echo "--- USB (sysfs)"
  ls /sys/bus/usb/devices/ 2>&1 | tr '\n' ' '; echo
  for d in /sys/bus/usb/devices/[0-9]*-*; do
    case "$(basename "$d")" in *:*) continue;; esac
    echo "  $(basename "$d")  $(cat "$d/idVendor" 2>/dev/null):$(cat "$d/idProduct" 2>/dev/null)  $(cat "$d/product" 2>/dev/null)"
  done
  echo "--- input devices"
  ls -l /dev/input/ 2>&1
  for e in /dev/input/event*; do
    [ -e "$e" ] || continue
    if (exec 3<"$e") 2>/dev/null; then echo "  $e: readable"; else echo "  $e: NOT readable"; fi
  done
  echo "--- block devices / mounts"
  ls -l /dev/sd* 2>&1
  grep -E '^/dev/sd' /proc/mounts 2>&1 || echo "  (no /dev/sd* mounted)"
  for m in $(grep -E '^/dev/sd' /proc/mounts | awk '{print $2}'); do
    if (touch "$m/.meridian_probe" && rm -f "$m/.meridian_probe") 2>/dev/null; then echo "  $m: writable by $(id -un)"
    else echo "  $m: NOT writable by $(id -un)"; fi
  done
  echo "--- serial devices"
  ls -l /dev/ttyACM* /dev/ttyUSB* 2>&1
  echo "--- time"
  echo "  system tz db: $( [ -d /usr/share/zoneinfo/America ] && echo present || echo absent); bundled: $( [ -d "$CAP_ROOT/zoneinfo/America" ] && echo present || echo absent)"
  chronyc -n tracking 2>&1 | grep -E 'Reference|Leap|System time' || echo "  chronyc not usable"
  echo "--- thermal"
  cat /sys/class/thermal/thermal_zone*/temp 2>&1
} > "$RW/diag.txt" 2>&1
cat "$RW/diag.txt"

# Prefer the Python bundled in the CAP; fall back to a system python3 if one exists.
PY=""
if "$CAP_ROOT/python/bin/python3" -c 'import ssl' >/dev/null 2>&1; then
  PY="$CAP_ROOT/python/bin/python3"
elif command -v python3 >/dev/null; then
  PY="$(command -v python3)"
fi
if [ -z "$PY" ]; then
  echo "meridian: no working python3 (bundled or system)."
  # Fallback so diag.txt can still be read from a browser: http://<reader>:$UI_PORT/diag.txt
  if command -v busybox >/dev/null && busybox --list 2>/dev/null | grep -qx httpd; then
    mkdir -p "$RW/diag_www" && cp "$RW/diag.txt" "$RW/diag_www/"
    exec busybox httpd -f -p "$UI_PORT" -h "$RW/diag_www"
  fi
  while true; do sleep 3600; done
fi

# ---- supervisor loop: restart the server if it exits
while true; do
  # shellcheck disable=SC2086
  "$PY" "$CAP_ROOT/app/server.py" --port "$UI_PORT" --data-dir "$RW" ${MERIDIAN_EXTRA_ARGS:-} >> "$LOG" 2>&1
  echo "$(date) server exited ($?); restarting in 5 s" >> "$LOG"
  if [ "$(wc -c < "$LOG")" -gt 1048576 ]; then
    tail -c 262144 "$LOG" > "$LOG.1" && mv "$LOG.1" "$LOG"
  fi
  sleep 5
done
